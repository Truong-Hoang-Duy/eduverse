# Supabase (lấy từ Project Settings → API trong dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Chỉ dùng server-side (KHÔNG có prefix NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=change-me-random-string

# Mã mời đăng ký tài khoản giáo viên
TEACHER_INVITE_CODE=change-me-invite-code
