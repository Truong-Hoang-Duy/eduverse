{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ai-service: dev",
      "type": "shell",
      "command": "${workspaceFolder}/ai-service/.venv/bin/python -m uvicorn app.main:app --reload --port 8000",
      "osx": {
        "command": "${workspaceFolder}/ai-service/.venv/bin/python -m uvicorn app.main:app --reload --port 8000"
      },
      "linux": {
        "command": "${workspaceFolder}/ai-service/.venv/bin/python -m uvicorn app.main:app --reload --port 8000"
      },
      "windows": {
        "command": "${workspaceFolder}/ai-service/.venv/Scripts/python.exe -m uvicorn app.main:app --reload --port 8000"
      },
      "options": {
        "cwd": "${workspaceFolder}/ai-service"
      },
      "presentation": {
        "panel": "dedicated",
        "group": "dev"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "web: dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "presentation": {
        "panel": "dedicated",
        "group": "dev"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Dev: web + ai-service",
      "dependsOn": ["ai-service: dev", "web: dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
