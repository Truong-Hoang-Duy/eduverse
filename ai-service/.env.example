# Gemini (lấy free tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Alias tự trỏ tới bản Flash mới nhất (gemini-2.5-flash đã bị khóa với key mới)
GEMINI_MODEL=gemini-flash-latest

# Key nội bộ — phải TRÙNG với AI_SERVICE_API_KEY trong web/.env
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AI_SERVICE_API_KEY=change-me-random-string

# Supabase (chỉ để tải file Storage khi chấm bài)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
